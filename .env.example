# Admin login for /admin. Leave empty to disable the admin page.
# Careful with special characters: write every "$" as "\$", and wrap the value in
# double quotes if it contains "#". Example: ADMIN_PASSWORD="my\$ecret#1" is my$ecret#1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Alert push notifications via ntfy (https://ntfy.sh). Point at a self-hosted ntfy, or "off".
# NTFY_URL=https://ntfy.sh
